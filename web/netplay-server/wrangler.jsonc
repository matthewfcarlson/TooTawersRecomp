{
  // (web port) the hosted game: the site (public/, made by web/site.mjs: the page and the build; players
  // import their own disc) and online co-op's signalling and relay (src/index.js, NETPLAY.md), one origin
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "twotowers-netplay",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // files first; the Worker answers what is not one (/match/<code>, /turn, /proof); a missing file is a 404, never
  // the page. The build (/build/) goes through the Worker first: only for players who showed they have the disc
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "none", "run_worker_first": ["/build/*"] },
  "durable_objects": {
    "bindings": [{ "name": "MATCH", "class_name": "Match" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Match"] }]
}
